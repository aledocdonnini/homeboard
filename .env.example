# apps/web/.env.local: valori da `npx supabase status` (locale) o dalla dashboard (produzione)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave pubblica VAPID per le notifiche push (la privata sta solo nei secret delle Edge Functions)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
