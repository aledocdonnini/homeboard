# ~/.asoundrc (lo scrive install.sh da device/config/asoundrc): l'audio predefinito di Roby.
# Uscita: gli altoparlanti del monitor, via HDMI ("hdmi:" converte nel formato che vuole il Pi).
# Ingresso: il microfono USB, con "plug" che converte frequenza e canali (voice lavora a 16 kHz mono).
pcm.!default {
  type asym
  playback.pcm "roby_out"
  capture.pcm "roby_in"
}
pcm.roby_out {
  type plug
  slave.pcm "hdmi:CARD=@HDMI_CARD@,DEV=0"
}
pcm.roby_in {
  type plug
  slave.pcm "dsnoop:CARD=@MIC_CARD@"
}
ctl.!default {
  type hw
  card @HDMI_CARD@
}
