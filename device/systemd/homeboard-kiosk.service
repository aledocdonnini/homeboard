[Unit]
Description=Homeboard: Chromium in kiosk su /casa
PartOf=homeboard-session.target
After=homeboard-brain.service
# Se Chromium va in crash in loop, systemd non smette di riprovare: la TV deve tornare da sola.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/homeboard/device/bin/kiosk.sh
Restart=always
RestartSec=3
