# Configurazione del Pi: ~/.config/homeboard/homeboard.env (install.sh la crea da questo esempio).
# La leggono tutti i servizi. Un valore per riga; i commenti stanno su righe loro (systemd non li vuole in coda).

# ——— brain: Supabase ———
# Le chiavi PUBBLICHE del progetto, le stesse della PWA (Supabase → Project Settings → API).
# Niente chiavi segrete: il Pi è un utente anonimo abbinato alla casa, i permessi li decidono le policy.
SUPABASE_URL="https://<progetto>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ——— Schermo ———
# overscan: margine per la cornice della Crezar, in % del lato corto (0-20), da tarare a occhio.
TV_URL="https://homeboard-roby.vercel.app/casa?overscan=4"
# Uscita video (vedi `wlr-randr`): HDMI-A-1 sul Pi 5. Vuoto = la prima trovata.
OUTPUT=""
# Pannello spento di notte: allinealo agli orari notturni della casa (Impostazioni nella PWA).
NIGHT_START="23:30"
NIGHT_END="07:00"

# ——— Audio (install.sh scrive ~/.asoundrc: uscita sull'HDMI, ingresso dal microfono USB) ———
# Scheda HDMI del monitor (aplay -l): vc4hdmi0 è la porta HDMI 0, quella vicina all'alimentazione.
HDMI_CARD="vc4hdmi0"
# Scheda del microfono USB (arecord -l). Vuoto = la prima trovata da install.sh.
MIC_CARD=""

# ——— Voce (tutte le opzioni: services/voice/README.md) ———
# Trascrizione: vosk (veloce) o whisper (più preciso, più lento).
ROBY_STT="vosk"
# Sintesi: kokoro (predefinita, in locale) o piper (più veloce, voce meno riuscita).
ROBY_TTS="kokoro"
ROBY_KOKORO_VOICE="im_nicola"
# Parola di attivazione: hey_jarvis finché non c'è il modello "ehi_roby" addestrato (README di voice).
ROBY_WAKE_MODEL="hey_jarvis"
ROBY_WAKE_THRESHOLD="0.5"
# Barge-in: "wake" (di nuovo la parola) o "vad" (basta parlare, solo con un microfono che cancella l'eco).
ROBY_BARGE_IN="wake"
# Microfono e altoparlante: vuoti = quelli di ~/.asoundrc. Per scegliere: python -m roby_voice.mics
ROBY_INPUT_DEVICE=""
ROBY_OUTPUT_DEVICE=""
# I due tasti del televisore (config/config.txt): microfono (KEY_1 = 2) e premi-e-parla (KEY_2 = 3).
ROBY_KEYS_DEVICE="/dev/input/by-path/*gpio*-event"
ROBY_KEY_MUTE="2"
ROBY_KEY_TALK="3"

# ——— Modello linguistico (facoltativo; README principale, "Modello linguistico") ———
# none (predefinito), ollama (in casa), groq o gemini (cloud gratuito, con ROBY_LLM_KEY), openai, custom.
# Con un provider in cloud le note non vengono mandate, a meno di ROBY_LLM_NOTES="si".
ROBY_LLM="none"
ROBY_LLM_MODEL=""
ROBY_LLM_KEY=""
ROBY_LLM_URL=""

# ——— Aggiornamenti (bin/update.sh, ogni notte alle 4:30) ———
# Il ramo da seguire; vuoto = niente aggiornamenti automatici.
UPDATE_BRANCH="main"
