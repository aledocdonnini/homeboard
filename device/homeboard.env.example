# Configurazione del Raspberry. Copiala in ~/.config/homeboard/homeboard.env e adattala.

# L'app. overscan: margine per la cornice della Crezar, in % del lato corto (0-20), da tarare a occhio.
# voce: il server Piper locale (bin/piper-server.py); toglila per usare la voce del browser.
TV_URL="https://homeboard.vercel.app/casa?overscan=4&voce=http://127.0.0.1:5002/?text="

# Uscita video (vedi `wlr-randr`): HDMI-A-1 con l'HDMI, DSI-1 con un pannello DSI. Vuoto = la prima trovata.
OUTPUT=""

# Pannello spento di notte. Tienilo allineato agli orari notturni della casa (default 23:30-07:00).
NIGHT_START="23:30"
NIGHT_END="07:00"

# Voce italiana di Piper (https://huggingface.co/rhasspy/piper-voices): paola o riccardo.
PIPER_VOICE="it_IT-paola-medium"
PIPER_PORT="5002"
