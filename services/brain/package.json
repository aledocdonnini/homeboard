{
  "name": "@homeboard/brain",
  "version": "0.1.0",
  "private": true,
  "description": "Il cervello della postazione di casa: riceve il testo da voice, interpreta, esegue, tiene timer e copia locale, parla con /casa.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "simulate": "node src/simulator.ts",
    "typecheck": "tsc -p . --noEmit",
    "eval:note": "node --disable-warning=ExperimentalWarning src/eval-notes.ts"
  },
  "dependencies": {
    "@homeboard/core": "*",
    "@homeboard/intents": "*",
    "@huggingface/transformers": "^4.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1"
  }
}
