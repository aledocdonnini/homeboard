{
  "name": "homeboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @homeboard/web",
    "build": "npm run build -w @homeboard/web",
    "lint": "npm run lint -w @homeboard/web",
    "typecheck": "npm run build -w roby-face && npm run typecheck --workspaces --if-present",
    "test": "node --test \"apps/*/src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\" \"supabase/functions/**/*.test.ts\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "supabase": "^2.118.0",
    "typescript": "^5.9.3"
  }
}
