# Copia in supabase/functions/.env (ignorato da git) per `npx supabase functions serve --env-file supabase/functions/.env`.
# Chiavi VAPID: npx web-push generate-vapid-keys. La pubblica va anche in apps/web/.env.local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:me@alessandrodonnini.dev
# In locale deve essere uguale al segreto che supabase/seed.sql mette nel Vault.
NOTIFY_SECRET=local-dev-notify-secret
